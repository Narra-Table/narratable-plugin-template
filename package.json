{
  "name": "narratable-plugin-template",
  "private": true,
  "license": "MIT",
  "scripts": {
    "check": "node ./build.mjs --assets && tsc --noEmit",
    "build": "node ./build.mjs",
    "release": "node ./build.mjs --release",
    "examples": "node ./build.mjs --root examples/coc7-rules --release && node ./build.mjs --root examples/coc7-commands --release"
  },
  "narratablePlugin": {
    "entry": "src/main.ts",
    "outfile": "dist/plugin.js",
    "minify": true
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3"
  }
}
